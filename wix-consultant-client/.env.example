# ============================================================================
# DEPLOYMENT CONFIGURATION
# ============================================================================

# Deployment URLs for each app (used for iframe src in Wix)
REACT_APP_STOREFRONT_URL=https://storefront-app.vercel.app
REACT_APP_CONSULTANT_URL=https://consultant-app.vercel.app
REACT_APP_CUSTOMER_URL=https://customer-app.vercel.app

# ============================================================================
# DEVELOPMENT CONFIGURATION
# ============================================================================

# Set to true to enable verbose logging
REACT_APP_DEBUG=false

# Development API fallback
REACT_APP_DEV_API_URL=http://localhost:3500

