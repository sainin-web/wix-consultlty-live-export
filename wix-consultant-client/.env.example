# WIX CONSULTANT PLATFORM - ENVIRONMENT VARIABLES
# Copy to .env and fill in actual values

# ============================================================================
# API & BACKEND CONFIGURATION
# ============================================================================

# Backend API URL - used by all apps
REACT_APP_BACKEND_HOST=https://test-wix-consultant.zend-apps.com
REACT_APP_API_URL=https://test-wix-consultant.zend-apps.com

# Frontend URL (for redirects, etc)
REACT_APP_FRONTEND_URL=https://test-wix-consultant.zend-apps.com

# ============================================================================
# WIX CONFIGURATION
# ============================================================================

# Wix domain (for CORS and iframe origin validation)
REACT_APP_WIX_DOMAIN=https://yourdomain.com

# Wix app credentials (if using Wix API)
REACT_APP_WIX_CLIENT_ID=your-wix-client-id
REACT_APP_WIX_INSTANCE_ID=your-wix-instance-id

